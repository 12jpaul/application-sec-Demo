# .env.example – copy to .env and fill in real values.
# NEVER commit .env to version control.
# Every secret is loaded from environment variables (Security rule 10).

# ── Django core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-use-get_random_secret_key

DEBUG=False

# Comma-separated list of allowed host names (no wildcards in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF (include scheme, e.g. https://sokolink.rw)
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Database (MySQL in production, see test.py for SQLite in CI) ─────────────
DATABASE_URL=mysql://sokolink_user:change-me-db-password@127.0.0.1:3306/sokolink_db

# ── Redis (Django Channels broker) ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Email (set to console in dev, SMTP in production) ────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@sokolink.rw
EMAIL_HOST_PASSWORD=change-me-email-password
EMAIL_USE_TLS=True

# ── SMS provider (console mock in dev) ───────────────────────────────────────
SMS_PROVIDER_API_KEY=change-me-sms-key
SMS_PROVIDER_SENDER_ID=SokoLink

# ── Payment provider (sandbox in dev) ────────────────────────────────────────
PAYMENT_PROVIDER_API_KEY=change-me-payment-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_PROVIDER_SANDBOX=True

# ── Push notifications ────────────────────────────────────────────────────────
PUSH_PROVIDER_API_KEY=change-me-push-key

# ── OTP HMAC key (T2/SR-02: keyed hash prevents offline brute-force of 6-digit codes) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_HMAC_KEY=change-me-otp-hmac-key

# ── Storage (private; signed URLs served through Django in dev) ──────────────
# Set to a cloud storage URL in production, e.g. s3://bucket/
MEDIA_ROOT=media/
MEDIA_URL=/media/

# ── Security headers (prod only; set via Nginx + Django) ─────────────────────
# SECURE_PROXY_SSL_HEADER is set in prod.py; Nginx must forward X-Forwarded-Proto
